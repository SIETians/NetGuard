# NetGuard Environment Configuration
# Copy this file to .env and fill in your values

# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# NetGuard Encryption Key (generate a new one for production)
NETGUARD_ENCRYPTION_KEY=your-encryption-key-here

# AI API Key (required for chat functionality)
GROQ_API_KEY=your-groq-api-key-here